# Vite env for ows-example-host (copy to .env.local)

# Wallet iframe URL (layer B)
VITE_WALLET_IFRAME_URL=http://localhost:5174

# ngrok authtoken for `npm run tunnel` (https://dashboard.ngrok.com/get-started/your-authtoken)
# NGROK_AUTHTOKEN=

# Optional: reserved domain (repo root .env) — e.g. immune-sheep-light.ngrok-free.app
# NGROK_DOMAIN=
