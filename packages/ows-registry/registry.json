{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ows",
  "homepage": "https://github.com/1Shot-API/open-wallet",
  "items": [
    {
      "name": "approval-dialog",
      "type": "registry:component",
      "title": "Signing approval dialog",
      "description": "Vanilla modals for EIP-191 personal_sign and EIP-712 eth_signTypedData (_v3/_v4) — shows request details and Sign / Reject before calling the signer.",
      "registryDependencies": [],
      "dependencies": ["@1shotapi/ows-branding-core"],
      "files": [
        {
          "path": "items/approval-dialog/vanilla/install.ts",
          "type": "registry:file",
          "target": "src/ows/approval-dialog/install.ts"
        },
        {
          "path": "items/approval-dialog/vanilla/dialog.ts",
          "type": "registry:file",
          "target": "src/ows/approval-dialog/dialog.ts"
        }
      ]
    },
    {
      "name": "create-backup",
      "type": "registry:component",
      "title": "Create encrypted wallet backup",
      "description": "Vanilla dialog that mounts the signer iframe for passphrase entry, then shows the encrypted recovery blob with copy.",
      "registryDependencies": [],
      "dependencies": ["@1shotapi/ows-branding-core"],
      "files": [
        {
          "path": "items/create-backup/vanilla/install.ts",
          "type": "registry:file",
          "target": "src/ows/create-backup/install.ts"
        },
        {
          "path": "items/create-backup/vanilla/dialog.ts",
          "type": "registry:file",
          "target": "src/ows/create-backup/dialog.ts"
        }
      ]
    },
    {
      "name": "recover-backup",
      "type": "registry:component",
      "title": "Restore encrypted wallet backup",
      "description": "Vanilla dialog that mounts the signer iframe for passphrase entry and calls recoverKey with an app-supplied backup blob.",
      "registryDependencies": [],
      "dependencies": ["@1shotapi/ows-branding-core"],
      "files": [
        {
          "path": "items/recover-backup/vanilla/install.ts",
          "type": "registry:file",
          "target": "src/ows/recover-backup/install.ts"
        },
        {
          "path": "items/recover-backup/vanilla/dialog.ts",
          "type": "registry:file",
          "target": "src/ows/recover-backup/dialog.ts"
        }
      ]
    },
    {
      "name": "rpc-provider",
      "type": "registry:component",
      "title": "EIP-1193 JSON-RPC reads",
      "description": "Headless module that proxies non-signing EIP-1193 methods (eth_call, eth_getBalance, eth_chainId, …) to configured chain RPC URLs. No UI.",
      "registryDependencies": [],
      "dependencies": ["@1shotapi/ows-branding-core", "@1shotapi/ows-types"],
      "files": [
        {
          "path": "items/rpc-provider/vanilla/install.ts",
          "type": "registry:file",
          "target": "src/ows/rpc-provider/install.ts"
        }
      ]
    }
  ]
