{
  "name": "@1shotapi/ows-credentials",
  "version": "0.0.0",
  "description": "OWS verifiable credentials extension — types, provider contract, OID4VCI/OID4VP abstractions, and mocks",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./mock": {
      "types": "./dist/mock/index.d.ts",
      "import": "./dist/mock/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --import tsx --test test/*.test.ts",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@1shotapi/ows-types": "*",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0"
  },
  "keywords": [
    "ows",
    "open-wallet-standard",
    "verifiable-credentials",
    "oid4vci",
    "oid4vp"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1Shot-API/open-wallet.git",
    "directory": "packages/ows-credentials"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
