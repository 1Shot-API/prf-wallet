{
  "name": "@1shotapi/wagmi-connector",
  "version": "0.2.0",
  "description": "wagmi connector for the 1Shot Embedded Wallet (OWS Branding Layer iframe)",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src/oneShotWallet.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@1shotapi/ows-provider": ">=0.9.0",
    "@wagmi/core": "^3.0.0",
    "viem": "2.x"
  },
  "devDependencies": {
    "@1shotapi/ows-provider": "*",
    "@wagmi/core": "^3.6.9",
    "viem": "^2.52.0",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "wagmi",
    "connector",
    "1shot",
    "ows",
    "open-wallet-standard",
    "embedded-wallet",
    "passkey"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/1Shot-API/open-wallet.git",
    "directory": "packages/ows-wagmi"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
